---
import { SITE_CONFIG } from '../../data/site';
import FloatingButtons from '../ui/FloatingButtons.astro';
---

<section
  id="inicio"
  class="relative min-h-svh flex items-center overflow-hidden"
  style="background: var(--color-bg-base)"
>
  <!-- Blob decorativo de fundo -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
  >
    <div
      class="absolute top-1/4 right-0 w-96 h-96 rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(circle, var(--color-accent-primary), transparent 70%)"
    ></div>
    <div
      class="absolute bottom-1/4 left-0 w-64 h-64 rounded-full opacity-10 blur-3xl"
      style="background: radial-gradient(circle, var(--color-accent-warm), transparent 70%)"
    ></div>
  </div>

  <div class="container-base relative z-10 py-20 md:py-0">
    <div class="grid md:grid-cols-2 gap-12 items-center">

      <!-- Coluna esquerda — conteúdo -->
      <div class="order-2 md:order-1">

        <!-- Chip tag -->
        <span
          class="inline-block text-xs font-mono uppercase tracking-widest mb-4 px-3 py-1 rounded-full"
          style="color: var(--color-accent-warm); background: var(--color-accent-primary-light)"
        >
          Back-end &amp; IA
        </span>

        <!-- Nome principal -->
        <h1
          class="font-heading font-bold leading-tight mb-3"
          style="font-size: clamp(2.5rem, 6vw, 4.5rem); color: var(--color-text-primary)"
        >
          {SITE_CONFIG.ownerName}
        </h1>

        <!-- Título profissional -->
        <p
          class="font-heading font-semibold text-2xl md:text-3xl mb-4"
          style="color: var(--color-accent-primary)"
        >
          {SITE_CONFIG.ownerTitle}
        </p>

        <!-- Bio -->
        <p
          class="text-lg leading-relaxed max-w-md mb-8"
          style="color: var(--color-text-secondary)"
        >
          {SITE_CONFIG.ownerBio}
        </p>

        <!-- CTAs (BR-MIGRAR-008, BR-MIGRAR-009) -->
        <div class="flex flex-wrap gap-4">
          <a
            href="#portfolio"
            class="btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-white transition-all duration-300"
            style="background: var(--color-accent-primary)"
          >
            Ver Portfolio
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>

          <a
            href="#contato"
            class="btn-whatsapp inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-white transition-all duration-300"
            style="background: var(--color-whatsapp)"
          >
            Falar no WhatsApp
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
            </svg>
          </a>
        </div>

      </div>

      <!-- Coluna direita — blob visual decorativo (desktop only) -->
      <div class="order-1 md:order-2 hidden md:flex items-center justify-center" aria-hidden="true">
        <div class="relative w-72 h-72 lg:w-96 lg:h-96">
          <!-- Círculo externo -->
          <div
            class="absolute inset-0 rounded-full opacity-30"
            style="background: conic-gradient(from 0deg, var(--color-accent-primary), var(--color-accent-warm), var(--color-accent-primary))"
          ></div>
          <!-- Círculo interno -->
          <div
            class="absolute inset-4 rounded-full flex items-center justify-center"
            style="background: var(--color-bg-card)"
          >
            <div class="text-center">
              <div
                class="text-5xl font-heading font-bold mb-1"
                style="color: var(--color-accent-warm)"
              >
                &lt;/&gt;
              </div>
              <div class="text-sm font-mono" style="color: var(--color-text-muted)">
                Python · Django · AI
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Scroll indicator -->
    <div class="text-center mt-16 md:mt-12" aria-hidden="true">
      <p
        class="text-sm animate-bounce inline-flex flex-col items-center gap-1"
        style="color: var(--color-text-muted)"
      >
        Role para baixo
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </p>
    </div>
  </div>
</section>

<!-- Botões flutuantes (aparecem ao sair do hero via IntersectionObserver) -->
<FloatingButtons />

<style>
  .btn-primary:hover {
    background: var(--color-accent-primary-hover) !important;
    transform: translateY(-1px);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-accent-primary) 40%, transparent);
  }

  .btn-whatsapp:hover {
    background: var(--color-whatsapp-hover) !important;
    transform: translateY(-1px);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-whatsapp) 40%, transparent);
  }
</style>
