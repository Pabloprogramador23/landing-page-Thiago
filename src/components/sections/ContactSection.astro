---
import { SITE_CONFIG } from '../../data/site';
import ExternalLink from '../ui/ExternalLink.astro';
import ContactForm from '../ui/ContactForm.astro';

const whatsappUrl = `https://wa.me/${SITE_CONFIG.whatsappNumber}`;
---

<section
  id="contato"
  class="section-padding"
  style="background: var(--color-bg-surface)"
>
  <div class="container-base">

    <!-- Cabeçalho -->
    <div class="text-center mb-16">
      <span
        class="inline-block text-xs font-mono uppercase tracking-widest mb-3 px-3 py-1 rounded-full"
        style="color: var(--color-accent-warm); background: var(--color-accent-primary-light)"
      >
        Contato
      </span>
      <h2
        class="font-heading font-bold text-3xl md:text-4xl"
        style="color: var(--color-text-primary)"
      >
        Vamos conversar?
      </h2>
    </div>

    <!-- Grid: info + formulário -->
    <div class="grid md:grid-cols-2 gap-12 items-start max-w-5xl mx-auto">

      <!-- Coluna de contato direto -->
      <div>
        <h3
          class="font-heading font-semibold text-lg mb-8"
          style="color: var(--color-text-primary)"
        >
          Prefere o contato direto? Estou disponível por:
        </h3>

        <div class="flex flex-col gap-4">

          <!-- WhatsApp -->
          <ExternalLink
            href={whatsappUrl}
            class="contact-item flex items-center gap-4 px-5 py-4 rounded-xl transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
              style="background: color-mix(in srgb, var(--color-whatsapp) 15%, transparent)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 16 16" style="color: var(--color-whatsapp)" aria-hidden="true">
                <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-mono uppercase tracking-wide mb-0.5" style="color: var(--color-text-muted)">WhatsApp</p>
              <p class="font-semibold text-sm" style="color: var(--color-text-primary)">{SITE_CONFIG.whatsappDisplay}</p>
            </div>
          </ExternalLink>

          <!-- Email -->
          <a
            href={`mailto:${SITE_CONFIG.email}`}
            class="contact-item flex items-center gap-4 px-5 py-4 rounded-xl transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
              style="background: color-mix(in srgb, var(--color-accent-primary) 10%, transparent)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="color: var(--color-accent-primary)" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-mono uppercase tracking-wide mb-0.5" style="color: var(--color-text-muted)">Email</p>
              <p class="font-semibold text-sm" style="color: var(--color-text-primary)">{SITE_CONFIG.email}</p>
            </div>
          </a>

          <!-- LinkedIn -->
          <ExternalLink
            href={SITE_CONFIG.linkedinUrl}
            class="contact-item flex items-center gap-4 px-5 py-4 rounded-xl transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
              style="background: color-mix(in srgb, var(--color-accent-primary) 10%, transparent)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 16 16" style="color: var(--color-accent-primary)" aria-hidden="true">
                <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-mono uppercase tracking-wide mb-0.5" style="color: var(--color-text-muted)">LinkedIn</p>
              <p class="font-semibold text-sm" style="color: var(--color-text-primary)">Pablo Magalhães</p>
            </div>
          </ExternalLink>

        </div>
      </div>

      <!-- Formulário -->
      <div
        class="rounded-2xl p-6 md:p-8"
        style="background: var(--color-bg-card); border: 1px solid var(--color-border)"
      >
        <ContactForm />
      </div>

    </div>
  </div>
</section>

<style>
  .contact-item {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    text-decoration: none;
  }

  .contact-item:hover {
    border-color: color-mix(in srgb, var(--color-accent-primary) 50%, transparent);
    background: var(--color-bg-card-hover);
    transform: translateX(4px);
  }
</style>
