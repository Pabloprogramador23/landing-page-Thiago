---
interface Props {
  href: string;
  class?: string;
  ariaLabel?: string;
}

const { href, class: className, ariaLabel } = Astro.props;
---

<!--
  Garante noopener noreferrer em todos os links externos por construção (DA-004, BR-MIGRAR-046).
  Corrige G-01 (tabnabbing) do legado.
-->
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={className}
  aria-label={ariaLabel}
>
  <slot />
</a>
