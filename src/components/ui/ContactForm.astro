---
// ContactForm — validação inline, anti-double-submit (AMB-004 / DEV-012), sem alert()
// Envio via wa.me — buildWhatsAppUrl de utils/whatsapp.ts
---

<form id="whatsappForm" class="flex flex-col gap-4" novalidate>

  <!-- Campo Nome -->
  <div>
    <label
      for="nome"
      class="block text-sm font-semibold mb-1"
      style="color: var(--color-text-primary)"
    >
      Nome completo
    </label>
    <input
      id="nome"
      type="text"
      placeholder="Digite seu nome completo"
      class="input-base"
      autocomplete="name"
    />
    <p class="text-xs mt-1 hidden" data-error="nome" style="color: var(--color-error)"></p>
  </div>

  <!-- Campo Telefone -->
  <div>
    <label
      for="telefone"
      class="block text-sm font-semibold mb-1"
      style="color: var(--color-text-primary)"
    >
      Telefone
    </label>
    <input
      id="telefone"
      type="tel"
      placeholder="(55) 22222-2222"
      class="input-base"
      autocomplete="tel"
    />
    <p class="text-xs mt-1 hidden" data-error="telefone" style="color: var(--color-error)"></p>
  </div>

  <!-- Campo Email -->
  <div>
    <label
      for="email"
      class="block text-sm font-semibold mb-1"
      style="color: var(--color-text-primary)"
    >
      Email
    </label>
    <input
      id="email"
      type="email"
      placeholder="Seu melhor email"
      class="input-base"
      autocomplete="email"
    />
    <p class="text-xs mt-1 hidden" data-error="email" style="color: var(--color-error)"></p>
  </div>

  <!-- Campo Mensagem -->
  <div>
    <label
      for="mensagem"
      class="block text-sm font-semibold mb-1"
      style="color: var(--color-text-primary)"
    >
      Mensagem
    </label>
    <textarea
      id="mensagem"
      rows="4"
      placeholder="Escreva o que você deseja aqui..."
      class="input-base resize-none"
    ></textarea>
    <p class="text-xs mt-1 hidden" data-error="mensagem" style="color: var(--color-error)"></p>
  </div>

  <!-- Botão submit -->
  <button
    id="submitBtn"
    type="submit"
    class="submit-btn w-full flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-semibold text-white transition-all duration-300"
    style="background: var(--color-whatsapp)"
  >
    <!-- Estado idle -->
    <span id="btnIdle" class="flex items-center gap-2">
      Enviar via WhatsApp
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
      </svg>
    </span>
    <!-- Estado submitting -->
    <span id="btnSubmitting" class="hidden flex items-center gap-2">
      Enviando…
      <svg class="w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
      </svg>
    </span>
  </button>

</form>

<script>
  import { formatPhone } from '../../utils/phone';
  import { validateEmail } from '../../utils/validation';
  import { buildWhatsAppUrl } from '../../utils/whatsapp';
  import { SITE_CONFIG } from '../../data/site';

  const form = document.getElementById('whatsappForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const btnIdle = document.getElementById('btnIdle') as HTMLElement;
  const btnSubmitting = document.getElementById('btnSubmitting') as HTMLElement;

  const nomeInput = document.getElementById('nome') as HTMLInputElement;
  const telefoneInput = document.getElementById('telefone') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const mensagemInput = document.getElementById('mensagem') as HTMLTextAreaElement;

  // Formata telefone em tempo real
  telefoneInput.addEventListener('input', () => {
    const formatted = formatPhone(telefoneInput.value);
    telefoneInput.value = formatted;
  });

  // Limpa erro do campo ao editar
  [nomeInput, telefoneInput, emailInput, mensagemInput].forEach((el) => {
    el.addEventListener('input', () => clearError(el.id));
  });

  function showError(field: string, message: string) {
    const el = form.querySelector(`[data-error="${field}"]`) as HTMLElement;
    if (!el) return;
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function clearError(field: string) {
    const el = form.querySelector(`[data-error="${field}"]`) as HTMLElement;
    if (!el) return;
    el.textContent = '';
    el.classList.add('hidden');
  }

  function clearAllErrors() {
    form.querySelectorAll('[data-error]').forEach((el) => {
      (el as HTMLElement).textContent = '';
      (el as HTMLElement).classList.add('hidden');
    });
  }

  function setSubmitting(state: boolean) {
    submitBtn.disabled = state;
    if (state) {
      btnIdle.classList.add('hidden');
      btnSubmitting.classList.remove('hidden');
      submitBtn.style.opacity = '0.6';
      submitBtn.style.cursor = 'not-allowed';
    } else {
      btnIdle.classList.remove('hidden');
      btnSubmitting.classList.add('hidden');
      submitBtn.style.opacity = '';
      submitBtn.style.cursor = '';
    }
  }

  function resetForm() {
    nomeInput.value = '';
    telefoneInput.value = '';
    emailInput.value = '';
    mensagemInput.value = '';
    clearAllErrors();
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearAllErrors();

    const nome = nomeInput.value.trim();
    const telefone = telefoneInput.value.trim();
    const email = emailInput.value.trim();
    const mensagem = mensagemInput.value.trim();

    // Validação inline — sem alert() (BR-MIGRAR-035, BR-MIGRAR-036)
    let hasErrors = false;

    if (!nome) {
      showError('nome', 'Nome é obrigatório');
      hasErrors = true;
    }
    if (!telefone) {
      showError('telefone', 'Telefone é obrigatório');
      hasErrors = true;
    }
    if (!email) {
      showError('email', 'Email é obrigatório');
      hasErrors = true;
    } else if (!validateEmail(email)) {
      showError('email', 'Email inválido');
      hasErrors = true;
    }
    if (!mensagem) {
      showError('mensagem', 'Mensagem é obrigatória');
      hasErrors = true;
    }

    if (hasErrors) return;

    // Anti-double-submit — AMB-004 / DEV-012
    setSubmitting(true);

    // Abre wa.me com mensagem formatada — BR-MIGRAR-038, BR-MIGRAR-039
    const url = buildWhatsAppUrl(
      { nome, telefone, email, mensagem },
      SITE_CONFIG.whatsappNumber
    );
    window.open(url, '_blank', 'noopener,noreferrer');

    // Reset após envio — BR-MIGRAR-040
    resetForm();
    setSubmitting(false);
  });
</script>

<style>
  .input-base {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    transition: border-color 0.3s, box-shadow 0.3s;
    outline: none;
  }

  .input-base::placeholder {
    color: var(--color-text-muted);
  }

  .input-base:focus {
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent-primary) 20%, transparent);
  }

  .submit-btn:hover:not(:disabled) {
    background: var(--color-whatsapp-hover) !important;
    transform: translateY(-1px);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-whatsapp) 40%, transparent);
  }
</style>
