---
import { SITE_CONFIG } from '../../data/site';

const whatsappUrl = `https://wa.me/${SITE_CONFIG.whatsappNumber}`;
---

<!--
  Par atômico backToTop + WhatsApp flutuante (BR-MIGRAR-012).
  Aparece quando o hero sai da viewport via IntersectionObserver (DA-006 — sem scroll listener).
  Fade-in/out com transition-all duration-500 (BR-MIGRAR-010, BR-MIGRAR-011).
-->
<div
  id="floating-buttons"
  class="fixed bottom-6 right-6 flex flex-col gap-3 z-40 transition-all duration-500 opacity-0 pointer-events-none translate-y-4"
  aria-hidden="true"
>
  <!-- BackToTop (BR-MIGRAR-013) -->
  <button
    id="back-to-top"
    aria-label="Voltar ao topo"
    class="w-12 h-12 rounded-full shadow-lg flex items-center justify-center transition-all duration-300 text-white"
    style="background: var(--color-accent-primary)"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
    </svg>
  </button>

  <!-- WhatsApp flutuante (BR-MIGRAR-014, BR-MIGRAR-015) -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contato via WhatsApp"
    class="w-12 h-12 rounded-full shadow-lg flex items-center justify-center transition-all duration-300 text-white"
    style="background: var(--color-whatsapp); animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
    </svg>
  </a>
</div>

<script>
  const floatingEl = document.getElementById('floating-buttons');
  const heroSection = document.getElementById('inicio');

  function showButtons() {
    floatingEl?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
    floatingEl?.setAttribute('aria-hidden', 'false');
  }

  function hideButtons() {
    floatingEl?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
    floatingEl?.setAttribute('aria-hidden', 'true');
  }

  // IntersectionObserver — sem scroll listener (DA-006, BR-MIGRAR-010)
  if (heroSection && floatingEl) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        entry.isIntersecting ? hideButtons() : showButtons();
      },
      { threshold: 0.1 }
    );
    observer.observe(heroSection);
  } else {
    // Fallback: se #inicio não existir ainda, usa scroll (será substituído quando HeroSection for criada)
    window.addEventListener(
      'scroll',
      () => { window.scrollY > 100 ? showButtons() : hideButtons(); },
      { passive: true }
    );
  }

  // BackToTop (BR-MIGRAR-013)
  document.getElementById('back-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
