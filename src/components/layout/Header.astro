---
import { NAV_LINKS } from '../../data/navigation';
import { SITE_CONFIG } from '../../data/site';
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-scrolled="false"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo -->
      <a
        href="#inicio"
        class="font-heading font-bold text-xl"
        style="color: var(--color-accent-warm)"
        aria-label="PabloTech — início da página"
      >
        PabloTech
      </a>

      <!-- Nav desktop -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Navegação principal">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium transition-colors duration-300"
            style="color: var(--color-text-secondary)"
            data-nav-link
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Controles desktop: toggle tema -->
      <div class="hidden md:flex items-center gap-3">
        <button
          id="theme-toggle-desktop"
          aria-label="Alternar tema claro/escuro"
          class="w-9 h-9 rounded-lg flex items-center justify-center transition-colors duration-300"
          style="color: var(--color-text-secondary); background: var(--color-bg-card)"
        >
          <!-- Sol (light mode icon) -->
          <svg id="icon-sun-d" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
          </svg>
          <!-- Lua (dark mode icon) -->
          <svg id="icon-moon-d" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </button>
      </div>

      <!-- Hamburger mobile -->
      <button
        id="hamburger-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menu"
        class="md:hidden w-10 h-10 flex items-center justify-center rounded-lg transition-colors duration-300"
        style="color: var(--color-text-primary)"
      >
        <!-- Hamburger icon -->
        <svg id="icon-hamburger" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <!-- Close icon -->
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="md:hidden fixed inset-0 top-16 z-40 flex flex-col items-center justify-center gap-8 transition-all duration-500 opacity-0 pointer-events-none -translate-y-4"
    style="background: color-mix(in srgb, var(--color-bg-base) 95%, transparent); backdrop-filter: blur(12px);"
    aria-hidden="true"
  >
    {NAV_LINKS.map((link) => (
      <a
        href={link.href}
        class="text-2xl font-heading font-semibold transition-colors duration-300 mobile-nav-link"
        style="color: var(--color-text-primary)"
      >
        {link.label}
      </a>
    ))}

    <!-- Toggle tema mobile -->
    <button
      id="theme-toggle-mobile"
      aria-label="Alternar tema claro/escuro"
      class="mt-4 px-6 py-2 rounded-xl text-sm font-medium transition-colors duration-300"
      style="color: var(--color-text-secondary); border: 1px solid var(--color-border)"
    >
      Alternar tema
    </button>
  </div>
</header>

<!-- Espaçador para compensar o header fixo -->
<div class="h-16 md:h-20"></div>

<script>
  const header = document.getElementById('site-header')!;
  const hamburgerBtn = document.getElementById('hamburger-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const iconHamburger = document.getElementById('icon-hamburger')!;
  const iconClose = document.getElementById('icon-close')!;
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  let isMenuOpen = false;

  // Scroll: header sólido após 10px
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 10;
    header.dataset.scrolled = String(scrolled);
    if (scrolled) {
      header.style.background = `color-mix(in srgb, var(--color-bg-base) 90%, transparent)`;
      header.style.backdropFilter = 'blur(12px)';
      header.style.borderBottom = '1px solid var(--color-border)';
    } else {
      header.style.background = 'transparent';
      header.style.backdropFilter = 'none';
      header.style.borderBottom = 'none';
    }
  }, { passive: true });

  function closeMenu() {
    isMenuOpen = false;
    mobileMenu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
    mobileMenu.setAttribute('aria-hidden', 'true');
    hamburgerBtn.setAttribute('aria-expanded', 'false');
    iconHamburger.classList.remove('hidden');
    iconClose.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  function openMenu() {
    isMenuOpen = true;
    mobileMenu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
    mobileMenu.setAttribute('aria-hidden', 'false');
    hamburgerBtn.setAttribute('aria-expanded', 'true');
    iconHamburger.classList.add('hidden');
    iconClose.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  }

  hamburgerBtn.addEventListener('click', () => {
    isMenuOpen ? closeMenu() : openMenu();
  });

  // Fechar ao clicar em link (BR-MIGRAR-003)
  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Fechar com Escape (DEV-003b — acessibilidade)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) closeMenu();
  });

  // Toggle de tema — usa função global do BaseLayout
  const themeButtons = [
    document.getElementById('theme-toggle-desktop'),
    document.getElementById('theme-toggle-mobile'),
  ];
  themeButtons.forEach((btn) => {
    btn?.addEventListener('click', () => {
      (window as any).__toggleTheme?.();
      updateThemeIcons();
    });
  });

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    const sunD = document.getElementById('icon-sun-d');
    const moonD = document.getElementById('icon-moon-d');
    if (sunD && moonD) {
      sunD.classList.toggle('hidden', isDark);
      moonD.classList.toggle('hidden', !isDark);
    }
  }

  // Inicializar ícone correto
  updateThemeIcons();
</script>
